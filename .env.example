# ==============================================================================
# Portal Unificado — Bootcamp Itaú + DIO (Next.js Frontend + BFF / Vercel)
# ==============================================================================
# Copie este arquivo para .env.local e ajuste conforme seu ambiente.

# URL base do microsserviço Smart Budget Spring AI (local: 8080 | Render: https://seu-finance-ai.onrender.com)
BUDGET_API_URL=http://localhost:8080

# URL base do microsserviço Checkout API Design Patterns (local: 8081 | Render: https://seu-checkout.onrender.com)
CHECKOUT_API_URL=http://localhost:8081

# Chave secreta compartilhada (MESMO valor configurado em INTERNAL_API_KEY nos dois serviços do Render).
# Enviada apenas server-side pelo BFF no header X-Internal-Api-Key (nunca exposta ao navegador).
INTERNAL_API_KEY=

# (Opcional) URLs públicas do Swagger UI exibidas na página de Arquitetura.
# Em produção, mantenha comentado/vazio com SWAGGER_ENABLED=false nos microsserviços.
# NEXT_PUBLIC_BUDGET_SWAGGER_URL=http://localhost:8080/swagger-ui/index.html
# NEXT_PUBLIC_CHECKOUT_SWAGGER_URL=http://localhost:8081/swagger-ui/index.html
