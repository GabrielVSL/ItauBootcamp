# ==============================================================================
# Portal Unificado — Bootcamp Itaú + DIO (Next.js Frontend + BFF)
# ==============================================================================
# Copie este arquivo para .env.local e ajuste conforme seu ambiente.

# URL base do microsserviço Smart Budget Spring AI (padrão local: porta 8080)
BUDGET_API_URL=http://localhost:8080

# URL base do microsserviço Checkout API Design Patterns (padrão local: porta 8081)
CHECKOUT_API_URL=http://localhost:8081

# (Opcional) URLs públicas do Swagger UI exibidas na página de Arquitetura e no Rodapé.
# Se omitidas, o portal deriva automaticamente de BUDGET_API_URL e CHECKOUT_API_URL (/swagger-ui.html).
NEXT_PUBLIC_BUDGET_SWAGGER_URL=http://localhost:8080/swagger-ui/index.html
NEXT_PUBLIC_CHECKOUT_SWAGGER_URL=http://localhost:8081/swagger-ui/index.html
